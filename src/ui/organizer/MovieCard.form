<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.organizer.MovieCard">
  <grid id="mc001" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="250" height="300"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="mc002" binding="posterPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="6" left="8" bottom="6" right="8"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="210" height="110"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="mc003" class="javax.swing.JLabel" binding="posterPreviewLbl">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Movie Poster"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="mc004" binding="titleRowPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="mc005" class="javax.swing.JLabel" binding="movieTitleLbl">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Movie Title"/>
            </properties>
          </component>
          <component id="mc006" class="javax.swing.JLabel" binding="ratingBadgeLbl">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="PG-13"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="mc007" class="javax.swing.JLabel" binding="metaLbl">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Genre · 120 min"/>
        </properties>
      </component>
      <component id="mc008" class="javax.swing.JLabel" binding="descriptionLbl">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="9" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Movie description"/>
          <verticalAlignment value="1"/>
        </properties>
      </component>
      <grid id="mc009" binding="actionsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="8" vgap="-1">
        <margin top="4" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="2" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="mc010" class="javax.swing.JButton" binding="editBtn">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Edit"/>
            </properties>
          </component>
          <component id="mc011" class="javax.swing.JButton" binding="deleteBtn">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Delete"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
