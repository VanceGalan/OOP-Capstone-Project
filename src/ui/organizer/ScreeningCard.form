<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.organizer.ScreeningCard">
  <grid id="sc001" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="-1">
    <margin top="12" left="14" bottom="12" right="14"/>
    <constraints>
      <xy x="20" y="20" width="760" height="90"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="sc002" binding="infoPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="3">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="sc003" class="javax.swing.JLabel" binding="movieTitleLbl">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Movie Title"/>
            </properties>
          </component>
          <component id="sc004" class="javax.swing.JLabel" binding="detailsLbl">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Sat, Nov 14, 2026 • 7:00 PM · Hall 1 · ₱320.00"/>
            </properties>
          </component>
          <component id="sc005" class="javax.swing.JLabel" binding="reasonLbl">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Reason: ..."/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="sc006" class="javax.swing.JLabel" binding="statusBadgeLbl">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Pending"/>
        </properties>
      </component>
      <component id="sc007" class="javax.swing.JButton" binding="actionBtn">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Edit"/>
        </properties>
      </component>
      <component id="sc008" class="javax.swing.JButton" binding="deleteBtn">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Delete"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
