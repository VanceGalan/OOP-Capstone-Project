<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.organizer.AddEditMovie">
  <grid id="aem001" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="16" left="16" bottom="16" right="16"/>
    <constraints>
      <xy x="20" y="20" width="640" height="560"/>
    </constraints>
    <properties>
      <preferredSize width="640" height="560"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="aem002" binding="formCardPanel" layout-manager="GridLayoutManager" row-count="11" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="6">
        <margin top="18" left="20" bottom="18" right="20"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="aem003" class="javax.swing.JLabel" binding="screenTitleLbl">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Add / Edit Movie"/>
            </properties>
          </component>
          <component id="aem004" class="javax.swing.JLabel" binding="subtitleLbl">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Movies need NO approval — Save goes straight to Manage Movies."/>
            </properties>
          </component>
          <grid id="aem005" binding="fieldsGridPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="12" vgap="4">
            <margin top="6" left="0" bottom="4" right="0"/>
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="aem006" class="javax.swing.JLabel" binding="titleLbl">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Title"/>
                </properties>
              </component>
              <component id="aem007" class="javax.swing.JLabel" binding="genreLbl">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Genre"/>
                </properties>
              </component>
              <component id="aem008" class="javax.swing.JTextField" binding="titleField">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="aem009" class="javax.swing.JTextField" binding="genreField">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="aem010" class="javax.swing.JLabel" binding="durationLbl">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Duration (minutes)"/>
                </properties>
              </component>
              <component id="aem011" class="javax.swing.JLabel" binding="mtrcbLbl">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="MTRCB Rating"/>
                </properties>
              </component>
              <component id="aem012" class="javax.swing.JTextField" binding="durationField">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="aem013" class="javax.swing.JComboBox" binding="mtrcbRatingCombo">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
            </children>
          </grid>
          <component id="aem014" class="javax.swing.JLabel" binding="descriptionLbl">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Description"/>
            </properties>
          </component>
          <scrollpane id="aem015" binding="descriptionScroll">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="72"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="aem016" class="javax.swing.JTextArea" binding="descriptionArea">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <rows value="3"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <component id="aem017" class="javax.swing.JLabel" binding="posterLbl">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Poster"/>
            </properties>
          </component>
          <component id="aem018" class="javax.swing.JLabel" binding="posterHintLbl">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="File chooser + preview panel"/>
            </properties>
          </component>
          <grid id="aem019" binding="posterRowPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="-1">
            <margin top="2" left="0" bottom="2" right="0"/>
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <grid id="aem020" binding="posterPreviewPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="4" left="4" bottom="4" right="4"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                    <minimum-size width="72" height="90"/>
                    <preferred-size width="72" height="90"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="aem021" class="javax.swing.JLabel" binding="posterPreviewLbl">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <horizontalAlignment value="0"/>
                      <text value="Poster"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="aem022" class="javax.swing.JLabel" binding="posterPathLbl">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="No poster selected (title card used)"/>
                </properties>
              </component>
              <component id="aem023" class="javax.swing.JButton" binding="choosePosterBtn">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Choose Poster"/>
                </properties>
              </component>
            </children>
          </grid>
          <component id="aem024" class="javax.swing.JLabel" binding="errorMsgLbl">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value=" "/>
            </properties>
          </component>
          <grid id="aem025" binding="actionsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
            <margin top="2" left="0" bottom="2" right="0"/>
            <constraints>
              <grid row="9" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="aem026" class="javax.swing.JButton" binding="cancelBtn">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cancel"/>
                </properties>
              </component>
              <component id="aem027" class="javax.swing.JButton" binding="deleteBtn">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Delete"/>
                </properties>
              </component>
              <component id="aem028" class="javax.swing.JButton" binding="saveMovieBtn">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Save Movie"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="aem029" binding="noticeBannerPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="8" left="12" bottom="8" right="12"/>
            <constraints>
              <grid row="10" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="aem030" class="javax.swing.JLabel" binding="noticeLbl">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Delete warns if upcoming screenings exist."/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
