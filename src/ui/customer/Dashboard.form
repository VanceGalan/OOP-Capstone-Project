<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.customer.Dashboard">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="528" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="138c1" binding="bannerPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="38548" class="javax.swing.JLabel" binding="welcomeLabel">
            <constraints border-constraint="North"/>
            <properties>
              <text value="Welcome"/>
            </properties>
          </component>
          <component id="6167e" class="javax.swing.JLabel" binding="subtitleLabel">
            <constraints border-constraint="South"/>
            <properties>
              <text value="Label"/>
            </properties>
          </component>
          <component id="558e9" class="javax.swing.JButton" binding="avatarButton">
            <constraints border-constraint="East"/>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
          <component id="8b76d" class="javax.swing.JButton" binding="ticketsActiveButton">
            <constraints border-constraint="West"/>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="92176" binding="cardsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b3dbf" class="javax.swing.JButton" binding="browseButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
          <component id="23762" class="javax.swing.JButton" binding="bookingsButton">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
          <component id="e34c2" class="javax.swing.JButton" binding="profileButton">
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
          <hspacer id="6501d">
            <constraints>
              <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <hspacer id="c34f8">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <hspacer id="a1d1d">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <hspacer id="46dfa">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <grid id="fed5b" binding="bottomPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
